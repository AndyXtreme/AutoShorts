# AutoShorts settings with their defaults. The web UI (Settings page) reads
# and writes .env - copy this file to .env, or start the UI and save once.

# --- Core Settings ---
X_CENTER=0.5
Y_CENTER=0.5
MAX_ERROR_DEPTH=3
SCENE_LIMIT=4
TARGET_RATIO_W=9
TARGET_RATIO_H=16
MAX_OUTPUT_HEIGHT=1920
OUTPUT_VIDEO_CODEC=auto

# --- Action Detection ---
ACTION_W_AUDIO=0.6
ACTION_W_VIDEO=0.4
ACTION_SCORE_MODE=sum
SCENE_THRESHOLD=27.0
ACTION_FPS=6

# --- Dead Air Removal ---
REMOVE_SILENCE=true
SILENCE_MIN_GAP=1.0
SILENCE_PADDING=0.15
SILENCE_EDGE_PADDING=0.8
SILENCE_PEAK_LEAD=5.0
SILENCE_MIN_RESULT=8.0
SILENCE_MOTION_KEEP=0.5

# --- Clip Length Settings ---
CLIP_LENGTH_MODE=max
TARGET_SHORT_LENGTH=35
CLIP_LENGTH_PRESET=balanced
DYNAMIC_MAX_LENGTH=45
MIN_SHORT_LENGTH=15
RENDER_TAIL_BUFFER=1.5
MAX_SHORT_LENGTH=59
CLIP_END_SNAP=6.0
MAX_COMBINED_SCENE_LENGTH=0

# --- Subtitles ---
ENABLE_SUBTITLES=true
WHISPER_MODEL=medium
WHISPER_LANGUAGE=
WHISPER_USE_VAD=true
WHISPER_DROP_FOREIGN_SCRIPT=true
WHISPER_DROP_STOCK_PHRASES=true
VAD_MAX_REGION=10.0
VAD_MIN_REGION=0.5
VAD_PADDING=0.3
VAD_MERGE_GAP=0.5

# --- Caption Style & Layout ---
PYCAPS_TEMPLATE=hype
SUBTITLE_VIDEO_QUALITY=high
SUBTITLE_FONT_SIZE=0
SUBTITLE_MAX_LINES=2
SUBTITLE_MIN_LINES=1
SUBTITLE_MAX_CHARS=15
SUBTITLE_SPLIT_GAP=0.7
SUBTITLE_MIN_CHARS=10
SUBTITLE_WIDTH_RATIO=0.85
SUBTITLE_OVERFLOW=exceed_lines
SUBTITLE_VERTICAL_ALIGN=bottom
SUBTITLE_VERTICAL_OFFSET=-0.1
PYCAPS_KEEP_SPLITTERS=true

# --- Decord & Debug ---
DEBUG_SAVE_CHECKPOINT=false
DEBUG_SKIP_ANALYSIS=false
DEBUG_SKIP_RENDER=false
DEBUG_RENDERED_CLIPS=
